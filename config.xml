<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">

	<!-- Base Module Properties -->
	<id>mdrtb</id>
	<name>MDRTB</name>
	<version>1.4.3</version>
	<package>org.openmrs.module.mdrtb</package>
	<author>Esquared Systems</author>
	<description>MDRTB Module</description>

	<activator>org.openmrs.module.mdrtb.MdrtbActivator</activator>

	<!-- <updateURL>https://modules.openmrs.org/modules/download/mdrtb/update.rdf</updateURL> -->
	<!-- /Base Module Properties -->

	<require_version>2.3.1</require_version>

	<mappingFiles>
		LabTestAttribute.hbm.xml
	</mappingFiles>

	<!-- Extensions -->
	<extension>
		<point>org.openmrs.admin.list</point>
		<class>org.openmrs.module.mdrtb.extension.html.AdminList</class>
	</extension>

	<aware_of_modules>
		<aware_of_module>org.openmrs.module.legacyui</aware_of_module>
	</aware_of_modules>



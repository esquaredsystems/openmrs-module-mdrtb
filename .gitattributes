# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf

# Explicitly declare binary files
*.png binary
*.jpg binary
*.gif binary
*.jar binary

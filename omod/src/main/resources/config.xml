<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">

	<!-- Base Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>org.openmrs.module.mdrtb</package>
	<author>Esquared Systems</author>
	<description>${project.parent.description}</description>

	<activator>org.openmrs.module.mdrtb.MdrtbActivator</activator>

	<!-- <updateURL>https://modules.openmrs.org/modules/download/@MODULE_ID@/update.rdf</updateURL> -->
	<!-- /Base Module Properties -->

	<require_version>2.4.0</require_version>

	<require_modules>
		<require_module version="2.0.0">org.openmrs.module.reporting</require_module>
		<require_module version="2.10.0">org.openmrs.module.reportingcompatibility</require_module>
		<require_module version="2.51.0">org.openmrs.module.webservices.rest</require_module>
		<require_module version="2.21.0">org.openmrs.module.addresshierarchy</require_module>
	</require_modules>

	<mappingFiles>
		LabTestAttribute.hbm.xml
	</mappingFiles>

	<!-- Extensions -->
	<extension>
		<point>org.openmrs.gutter.tools</point>
		<class>org.openmrs.module.mdrtb.extension.html.MdrtbGutterItem</class>
	</extension>

	<aware_of_modules>
		<aware_of_module>org.openmrs.module.legacyui</aware_of_module>
	</aware_of_modules>

	<!-- Required Privileges -->
	<privilege>
		<name>Edit DOTS-MDR Data</name>
		<description>Allows user to access Form Entry pages/functions</description>
	</privilege>

	<!-- Message bundles are supplied by the mdrtb-api dependency when the module is packaged. -->
	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>
	<messages>
		<lang>ru</lang>
		<file>messages_ru.properties</file>
	</messages>
	<messages>
		<lang>tj</lang>
		<file>messages_tj.properties</file>
	</messages>

</module>
